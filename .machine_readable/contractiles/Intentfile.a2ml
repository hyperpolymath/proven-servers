# SPDX-License-Identifier: MPL-2.0
# Intentfile — declared work and longer-term goals for proven-servers.

@abstract:
This file records current repository intent. It is not evidence that an
implementation or check has already been completed.
@end

[intents]

[[item]]
id = "reproducible-toolchains"
description = "Record supported Idris2, Zig, Just, and binding toolchain versions."
status = "in-progress"
priority = "must"

[[item]]
id = "compiler-backed-package-matrix"
description = "Run all maintained Idris2 manifests and Zig build/test targets on a named revision; record failures and versions."
status = "blocked-on-toolchains"
priority = "must"

[[item]]
id = "abi-ffi-correspondence"
description = "Add generated-header, ABI-layout, symbol-signature, and native boundary checks for each bridge claimed as supported."
status = "declared"
priority = "must"

[[item]]
id = "binding-readiness"
description = "Compile, link, and execute each binding before upgrading its inventory status."
status = "in-progress"
priority = "intend"

[[item]]
id = "container-deployment"
description = "Keep container builds and publishing disabled until a real service executable and runtime tests exist."
status = "blocked-on-application-target"
priority = "must"

[aspirations]
formatter = "Adopt and pin language-specific formatters after the supported language/package scope is decided."
ci-matrix = "Run the supported compiler/test matrix in CI and preserve per-package results."
protocol-vectors = "Add authoritative protocol vectors, malformed-input suites, and interoperability evidence where applicable."
