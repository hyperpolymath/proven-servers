package proven-ctlog
version = "0.1.0"
authors = "Jonathan D.A. Jewell"
license = "MPL-2.0"
brief   = "Certificate Transparency lifecycle model; no persistent log, Merkle tree, or signing backend"

sourcedir = "src"
main = Main
executable = "proven-ctlog"

modules = CTLog
        , CTLog.Types
        , CTLogABI.Types
        , CTLogABI.Foreign
        , Main
