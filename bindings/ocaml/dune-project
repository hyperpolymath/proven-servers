; Dune project file for the current OCaml model/tag scaffolds.
; Native operations fail closed until OCaml-compatible C stubs are implemented.

(lang dune 3.0)

(name proven_servers)
(version 0.1.0)

(generate_opam_files true)

(authors "Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>")
(maintainers "Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>")
(license MPL-2.0)

(package
 (name proven_servers)
 (synopsis "proven-servers OCaml model scaffolds (native FFI unavailable)")
 (description
  "OCaml tag and model scaffolds for proven-servers. Native operations are \
   intentionally unavailable: direct OCaml external declarations to raw Zig \
   C symbols used the wrong calling convention. Implement OCaml-compatible C \
   stubs before advertising or enabling native FFI calls.")
 (depends
  (ocaml (>= 4.14))))
