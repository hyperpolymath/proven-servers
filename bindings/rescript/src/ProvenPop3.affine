module ProvenPop3;

// SPDX-License-Identifier: MPL-2.0
// Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
//
// POP3 protocol structs for the proven-servers ABI.
//
// Mirrors the Idris2 module POP3ABI.Types.
// All tag values match the Idris2 ABI tag definitions exactly.

// ===========================================================================
// Constants
// ===========================================================================

/// Standard POP3 port (RFC 1939).
fn pop3Port = 110

/// Standard POP3S (POP3 over TLS) port.
fn pop3sPort = 995

// ===========================================================================
// Command (tags 0-10)
// ===========================================================================

/// Standard POP3 port (RFC 1939).
struct command {
  | @as(0) User
  | @as(1) Pass
  | @as(2) Stat
  | @as(3) List
  | @as(4) Retr
  | @as(5) Dele
  | @as(6) Noop
  | @as(7) Rset
  | @as(8) Quit
  | @as(9) Top
  | @as(10) Uidl

/// Decode from the C-ABI tag value.
fn commandFromTag = (tag: int): option<command> =>
  switch tag {
  | 0 => Some(User)
  | 1 => Some(Pass)
  | 2 => Some(Stat)
  | 3 => Some(List)
  | 4 => Some(Retr)
  | 5 => Some(Dele)
  | 6 => Some(Noop)
  | 7 => Some(Rset)
  | 8 => Some(Quit)
  | 9 => Some(Top)
  | 10 => Some(Uidl)
  | _ => None
  }

/// Encode to the C-ABI tag value.
fn commandToTag = (v: command): int =>
  switch v {
  | User => 0
  | Pass => 1
  | Stat => 2
  | List => 3
  | Retr => 4
  | Dele => 5
  | Noop => 6
  | Rset => 7
  | Quit => 8
  | Top => 9
  | Uidl => 10
  }

/// Whether this command modifies mailbox state.
fn commandIsWrite = (v: command): bool =>
  switch v {
  | Dele | Rset => true
  | _ => false
  }

// ===========================================================================
// State (tags 0-2)
// ===========================================================================

/// Decode from an ABI tag value.
struct state {
  | @as(0) Authorization
  | @as(1) Transaction
  | @as(2) Update

/// Decode from the C-ABI tag value.
fn stateFromTag = (tag: int): option<state> =>
  switch tag {
  | 0 => Some(Authorization)
  | 1 => Some(Transaction)
  | 2 => Some(Update)
  | _ => None
  }

/// Encode to the C-ABI tag value.
fn stateToTag = (v: state): int =>
  switch v {
  | Authorization => 0
  | Transaction => 1
  | Update => 2
  }

// stateCanTransitionTo removed: unproven reimplementation. The verified check lives in the
// Idris2/Zig core; calling it needs @module FFI wiring not yet present for this
// protocol. Do not reimplement here. See docs/decisions/0003-keep-bindings-thin-abi-wrappers.md

// ===========================================================================
// Response (tags 0-1)
// ===========================================================================

/// Decode from an ABI tag value.
struct response {
  | @as(0) Ok
  | @as(1) Err

/// Decode from the C-ABI tag value.
fn responseFromTag = (tag: int): option<response> =>
  switch tag {
  | 0 => Some(Ok)
  | 1 => Some(Err)
  | _ => None
  }

/// Encode to the C-ABI tag value.
fn responseToTag = (v: response): int =>
  switch v {
  | Ok => 0
  | Err => 1
  }

/// Whether this response indicates success.
fn responseIsSuccess = (v: response): bool =>
  switch v {
  | Ok => true
  | _ => false
  }

// ===========================================================================
// Pop3Error (tags 0-5)
// ===========================================================================

/// Decode from an ABI tag value.
struct pop3Error {
  | @as(0) Ok
  | @as(1) InvalidSlot
  | @as(2) NotActive
  | @as(3) InvalidTransition
  | @as(4) InvalidCommand
  | @as(5) AuthFailed

/// Decode from the C-ABI tag value.
fn pop3ErrorFromTag = (tag: int): option<pop3Error> =>
  switch tag {
  | 0 => Some(Ok)
  | 1 => Some(InvalidSlot)
  | 2 => Some(NotActive)
  | 3 => Some(InvalidTransition)
  | 4 => Some(InvalidCommand)
  | 5 => Some(AuthFailed)
  | _ => None
  }

/// Encode to the C-ABI tag value.
fn pop3ErrorToTag = (v: pop3Error): int =>
  switch v {
  | Ok => 0
  | InvalidSlot => 1
  | NotActive => 2
  | InvalidTransition => 3
  | InvalidCommand => 4
  | AuthFailed => 5
  }

/// Whether this error code indicates success.
fn pop3ErrorIsSuccess = (v: pop3Error): bool =>
  switch v {
  | Ok => true
  | _ => false
  }


